# Nur Namen, keine echten Werte. Echte Schlüssel nur in Vercel (Settings → Environment Variables, "Sensitive").
STRIPE_SECRET_KEY=        # am besten eingeschränkter Schlüssel rk_live_… (Checkout Sessions: Schreiben, Invoices: Lesen)
STRIPE_WEBHOOK_SECRET=    # whsec_… vom Webhook-Endpunkt https://foav.de/api/stripe/webhook
INVOICE_FOOTER=           # z. B. "Gemäß § 19 UStG wird keine Umsatzsteuer berechnet." (nur Kleinunternehmer)
RESEND_API_KEY=           # Pflicht: damit Anfragen, Fragebögen und Bestellungen bei Ihnen ankommen (resend.com)
INQUIRY_TO=fd.solutions@web.de
BLOB_READ_WRITE_TOKEN=    # Foto-Upload; zugleich Ablage für alles, was nicht per E-Mail zugestellt werden konnte (Ordner eingang/)
