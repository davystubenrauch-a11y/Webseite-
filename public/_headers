# Cloudflare Workers static assets: cache headers (served before the worker).
# Media rarely change; when one does, give it a new name or ?v= so visitors get the new file.
/videos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/media/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/social/*
  Cache-Control: public, max-age=604800
/site/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/site/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/site/*.html
  Cache-Control: public, max-age=0, must-revalidate
