{
  // foav.de on Cloudflare Workers (Next.js via @opennextjs/cloudflare).
  // Build + deploy: npm run deploy   (local preview in the Workers runtime: npm run preview)
  // Secrets (never in this file): RESEND_API_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
  //   -> Cloudflare dashboard: Workers & Pages → foav → Settings → Variables and Secrets, or `npx wrangler secret put NAME`
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "foav",
  "account_id": "b8c617a4185365bfed4babc588bba233",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // html_handling none: /site/index.html stays a file (no redirect to /site/), like on Vercel
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS", "html_handling": "none", "not_found_handling": "none" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "foav" }],
  // Photo uploads from the questionnaires (+ last-resort inbox under eingang/)
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "foav-uploads" }],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
